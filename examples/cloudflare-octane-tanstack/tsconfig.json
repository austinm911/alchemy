{
  "include": [
    "alchemy.run.ts",
    "src/**/*",
    "test/**/*.ts",
    "vite.config.ts"
  ],
  "compilerOptions": {
    "strict": true,
    "esModuleInterop": true,
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "allowImportingTsExtensions": true,
    "lib": ["DOM", "DOM.Iterable", "ES2024"],
    "isolatedModules": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "target": "ES2024",
    "types": ["bun", "vite/client", "@cloudflare/workers-types"],
    "noEmit": true,
    "jsx": "react-jsx",
    "jsxImportSource": "octane"
  }
}
